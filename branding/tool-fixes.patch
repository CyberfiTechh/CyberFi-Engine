diff --git a/packages/happy-agent-modules/tests/mcp/McpProtocolServerNames.test.ts b/packages/happy-agent-modules/tests/mcp/McpProtocolServerNames.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/happy-agent-modules/tests/mcp/McpProtocolServerNames.test.ts
@@ -0,0 +1,101 @@
+import { createRootContext } from "@steve.kite/stdlib";
+import { describe, expect, it, vi } from "vitest";
+
+import { createMcpProtocolTools } from "../../sources/mcp/createMcpProtocolTools.js";
+import type { McpModule } from "../../sources/mcp/McpModule.js";
+
+const ctx = createRootContext().named("mcp-server-name-test");
+
+function fixture(names: string[] = ["math_core", "pdrkocum_ai_fetch"]) {
+    const module = {
+        listToolPage: vi.fn().mockResolvedValue({ tools: [] }),
+        callTool: vi.fn().mockResolvedValue({ content: [] }),
+        listResourcePage: vi.fn().mockResolvedValue({ resources: [] }),
+        listResourceTemplatePage: vi.fn().mockResolvedValue({ resourceTemplates: [] }),
+        readResource: vi.fn().mockResolvedValue({ contents: [] }),
+        listPromptPage: vi.fn().mockResolvedValue({ prompts: [] }),
+        getPrompt: vi.fn().mockResolvedValue({ messages: [] }),
+    };
+    const tools = createMcpProtocolTools(
+        module as unknown as McpModule,
+        "agent",
+        names.map((name) => ({ name })),
+    );
+    return { module, tool: (name: string) => tools.find((tool) => tool.name === name)!, tools };
+}
+
+describe("MCP protocol server identities", () => {
+    it("advertises the exact callable identifiers rather than only display names", () => {
+        const { tools } = fixture();
+        for (const tool of tools) {
+            expect(tool.description).toContain('"math_core"');
+            expect(tool.description).toContain('"pdrkocum_ai_fetch"');
+        }
+    });
+
+    it.each([
+        ["list_mcp_tools", "listToolPage", { cursor: "next" }],
+        ["call_mcp_tool", "callTool", { name: "echo", arguments: { text: "hello" } }],
+        ["list_mcp_resources", "listResourcePage", { cursor: "next" }],
+        ["list_mcp_resource_templates", "listResourceTemplatePage", { cursor: "next" }],
+        ["read_mcp_resource", "readResource", { uri: "fixture://math" }],
+        ["list_mcp_prompts", "listPromptPage", { cursor: "next" }],
+        ["get_mcp_prompt", "getPrompt", { name: "hello", arguments: { text: "hello" } }],
+    ] as const)(
+        "resolves a unique display name for %s before calling the module",
+        async (name, method, input) => {
+            const { module, tool } = fixture();
+            await tool(name).execute(ctx, { server: "Math Core", ...input }, undefined as never);
+            expect(module[method]).toHaveBeenCalledWith(ctx, "agent", {
+                server: "math_core",
+                ...input,
+            });
+        },
+    );
+
+    it("resolves the displayed Pdrkocum name without changing its registration", async () => {
+        const { module, tool } = fixture();
+        await tool("list_mcp_tools").execute(
+            ctx,
+            { server: "Pdrkocum Ai Fetch" },
+            undefined as never,
+        );
+        expect(module.listToolPage).toHaveBeenCalledWith(ctx, "agent", {
+            server: "pdrkocum_ai_fetch",
+        });
+    });
+
+    it("gives an exact identifier priority over a matching display name", async () => {
+        const { module, tool } = fixture(["Math Core", "math_core"]);
+        await tool("list_mcp_tools").execute(ctx, { server: "Math Core" }, undefined as never);
+        expect(module.listToolPage).toHaveBeenCalledWith(ctx, "agent", { server: "Math Core" });
+    });
+
+    it("refuses an ambiguous display name while exact identifiers remain callable", async () => {
+        const { module, tool } = fixture(["math_core", "math-core"]);
+        await expect(
+            tool("list_mcp_tools").execute(ctx, { server: "Math Core" }, undefined as never),
+        ).rejects.toThrow("Ambiguous MCP server");
+        expect(module.listToolPage).not.toHaveBeenCalled();
+        await tool("list_mcp_tools").execute(ctx, { server: "math_core" }, undefined as never);
+        expect(module.listToolPage).toHaveBeenCalledWith(ctx, "agent", { server: "math_core" });
+    });
+
+    it("refuses unknown names without guessing and returns exact available identifiers", async () => {
+        const { module, tool } = fixture();
+        await expect(
+            tool("list_mcp_tools").execute(ctx, { server: "Math" }, undefined as never),
+        ).rejects.toThrow('Available servers: "math_core", "pdrkocum_ai_fetch"');
+        expect(module.listToolPage).not.toHaveBeenCalled();
+    });
+
+    it("keeps permission and review boundaries on the real definitions", () => {
+        const { tools } = fixture();
+        for (const tool of tools) {
+            expect(tool.requiresAutoOrFullAccess).toBe(true);
+            expect(tool.shouldReviewInAutoMode?.({} as never, ctx)).toBe(
+                ["call_mcp_tool", "get_mcp_prompt"].includes(tool.name),
+            );
+        }
+    });
+});
