index 0000000..fad4ce4
--- /dev/null
+++ b/packages/happy-agent/scripts/verifyProviderBinding.ts
@@ -0,0 +1,29 @@
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+const FIXED_SEARCH_SHA256 = "8105df6311ca2a7f9c36094cc5a1855721a2aee5eab8dad77ba55d7523eddd96";
+const SEARCH_PATH = "dist/vendors/codex/impl/searchCodexTools.js";
+
+/** Fail before bundling if the published provider lacks the reviewed discovery fix. */
+export function verifyProviderBinding(providerRoot: string, compiledProviderRoot: string): string {
+    const manifest = JSON.parse(readFileSync(join(providerRoot, "package.json"), "utf8")) as {
+        name?: unknown;
+        version?: unknown;
+    };
+    if (manifest.name !== "@slopus/happy-providers" || manifest.version !== "0.0.53") {
+        throw new Error("The standalone build requires the pinned happy-providers 0.0.53 package.");
+    }
+    const compiled = readFileSync(join(compiledProviderRoot, SEARCH_PATH));
+    const hash = createHash("sha256").update(compiled).digest("hex");
+    if (hash !== FIXED_SEARCH_SHA256) {
+        throw new Error("Build the reviewed happy-providers discovery fix before bundling.");
+    }
+    const installed = readFileSync(join(providerRoot, SEARCH_PATH));
+    if (!installed.equals(compiled)) {
+        throw new Error(
+            "The resolved happy-providers discovery module differs from the reviewed build; install the frozen patched lockfile.",
+        );
+    }
+    return hash;
+}
