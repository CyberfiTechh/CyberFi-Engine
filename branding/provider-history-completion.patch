+import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join, resolve } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+
+import { verifyProviderBinding } from "../scripts/verifyProviderBinding.js";
+
+const owned: string[] = [];
+const searchPath = "dist/vendors/codex/impl/searchCodexTools.js";
+
+function fixture() {
+    const root = mkdtempSync(join(tmpdir(), "cyberfi-provider-binding-"));
+    owned.push(root);
+    const installed = join(root, "installed");
+    const compiled = join(root, "compiled");
+    const bytes = readFileSync(
+        resolve(import.meta.dirname, "../../happy-providers/dist", searchPath.slice(5)),
+    );
+    for (const path of [installed, compiled]) {
+        mkdirSync(dirname(join(path, searchPath)), { recursive: true });
+        writeFileSync(join(path, searchPath), bytes);
+    }
+    writeFileSync(
+        join(installed, "package.json"),
+        JSON.stringify({ name: "@slopus/happy-providers", version: "0.0.53" }),
+    );
+    return { installed, compiled };
+}
+
+afterEach(() => {
+    for (const root of owned.splice(0)) rmSync(root, { recursive: true, force: true });
+});
+
+describe("standalone provider binding", () => {
+    it("accepts the exact reviewed compiled search module", () => {
+        const { installed, compiled } = fixture();
+        expect(verifyProviderBinding(installed, compiled)).toBe(
+            "8105df6311ca2a7f9c36094cc5a1855721a2aee5eab8dad77ba55d7523eddd96",
+        );
+    });
+    it("rejects an unpatched published provider", () => {
+        const { installed, compiled } = fixture();
+        writeFileSync(join(installed, searchPath), "// stale published module\n");
+        expect(() => verifyProviderBinding(installed, compiled)).toThrow(
+            "differs from the reviewed build",
+        );
+    });
+    it("rejects a missing compiled source", () => {
+        const { installed, compiled } = fixture();
+        rmSync(join(compiled, searchPath));
+        expect(() => verifyProviderBinding(installed, compiled)).toThrow();
+    });
+    it("rejects matching but stale installed and compiled modules", () => {
+        const { installed, compiled } = fixture();
+        for (const root of [installed, compiled])
+            writeFileSync(join(root, searchPath), "// stale\n");
+        expect(() => verifyProviderBinding(installed, compiled)).toThrow(
+            "reviewed happy-providers discovery fix",
+        );
+    });
+    it("rejects a different provider version", () => {
+        const { installed, compiled } = fixture();
+        writeFileSync(
+            join(installed, "package.json"),
+            JSON.stringify({ name: "@slopus/happy-providers", version: "0.0.48" }),
+        );
+        expect(() => verifyProviderBinding(installed, compiled)).toThrow(
+            "pinned happy-providers 0.0.53",
+        );
+    });
+});
