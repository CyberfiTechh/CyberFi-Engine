diff --git a/packages/happy-agent-compute/tests/processes/impl/shellCommandArgs.test.ts b/packages/happy-agent-compute/tests/processes/impl/shellCommandArgs.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/happy-agent-compute/tests/processes/impl/shellCommandArgs.test.ts
@@ -0,0 +1,37 @@
+import { spawnSync } from "node:child_process";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { shellCommandArgs } from "../../../sources/processes/impl/shellCommandArgs.js";
+
+describe.skipIf(process.platform !== "win32")("Windows PowerShell command encoding", () => {
+    const powershell = join(process.env.SystemRoot ?? "C:\\Windows", "System32", "WindowsPowerShell", "v1.0", "powershell.exe");
+    const run = (script: string, input?: string) =>
+        spawnSync(powershell, shellCommandArgs(powershell, script), {
+            encoding: "utf8",
+            input,
+            windowsHide: true,
+        });
+
+    it("round-trips UTF-8 through native stdin and stdout", () => {
+        const text = "çğıİöşü 日本語 🚀";
+        const node = process.execPath.replaceAll("'", "''");
+        const script = [
+            "[Console]::ReadLine()",
+            "'" + text + "' | & '" + node + "' -e 'process.stdin.pipe(process.stdout)'",
+            "Write-Output '" + text + "'",
+        ].join("\n");
+        const result = run(script, text + "\n");
+        expect(result.status).toBe(0);
+        expect(result.stdout.trim().split(/\r?\n/)).toEqual([text, text, text]);
+    });
+
+    it("keeps script prologues and command exit status", () => {
+        expect(run("using namespace System; param($s = 'ç'); [String]$s").stdout.trim()).toBe("ç");
+        expect(run("begin { 'ç' } end { 'ş' }").stdout.trim().split(/\r?\n/)).toEqual(["ç", "ş"]);
+        expect(run("cmd /d /c exit 17").status).toBe(1);
+        expect(run("exit 17").status).toBe(17);
+        expect(run("Write-Error 'ç'").stderr).toContain("ç");
+        expect(run("Write-Error 'ç'").status).toBe(1);
+        expect(run("if (").status).toBe(1);
+    });
+});
diff --git a/packages/happy-agent-modules/tests/compute/impl/readComputeTextFile.test.ts b/packages/happy-agent-modules/tests/compute/impl/readComputeTextFile.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/happy-agent-modules/tests/compute/impl/readComputeTextFile.test.ts
@@ -0,0 +1,68 @@
+import { createRootContext } from "@steve.kite/stdlib";
+import { describe, expect, it, vi } from "vitest";
+
+import { readComputeTextFile } from "../../../sources/compute/impl/readComputeTextFile.js";
+import type { FileReadLog } from "../../../sources/impl/FileReadLog.js";
+import { FakeCompute } from "../support/FakeCompute.js";
+
+const ctx = createRootContext().named("compute-text-encoding");
+const path = "/workspace/Çalışma alanı/öğrenci-🚀.txt";
+const text = "çğıİöşü 🚀";
+
+function fixture(bytes: Uint8Array) {
+    const compute = new FakeCompute();
+    compute.writeBuffer(path, bytes);
+    const record = vi.fn(async () => {});
+    const reads = { record } as unknown as FileReadLog;
+    return {
+        record,
+        read: (encoding?: string) =>
+            readComputeTextFile(compute, reads, ctx, {
+                path,
+                maxLines: 1,
+                ...(encoding === undefined ? {} : { encoding }),
+            }),
+    };
+}
+
+describe("compute text read encodings", () => {
+    const unicode = text + "\r\nsecond line";
+    const littleEndian = Buffer.from(unicode, "utf16le");
+    it.each([
+        ["UTF-8", Buffer.from(unicode, "utf8")],
+        ["UTF-8 BOM", Buffer.from("\ufeff" + unicode, "utf8")],
+        ["UTF-16 LE BOM", Buffer.concat([Buffer.from([0xff, 0xfe]), littleEndian])],
+        [
+            "UTF-16 BE BOM",
+            Buffer.concat([Buffer.from([0xfe, 0xff]), Buffer.from(littleEndian).swap16()]),
+        ],
+    ] as const)("reads %s and keeps line paging", async (_encoding, bytes) => {
+        const { read, record } = fixture(bytes);
+
+        await expect(read()).resolves.toMatchObject({
+            path,
+            lines: [text],
+            startLine: 1,
+            totalLines: 2,
+            moreLines: true,
+        });
+        expect(record).toHaveBeenCalledOnce();
+    });
+
+    it("reads a known legacy encoding without guessing it", async () => {
+        const { read, record } = fixture(Uint8Array.of(0xe7, 0xf0, 0xfd, 0xdd, 0xf6, 0xfe, 0xfc));
+
+        await expect(read()).rejects.toThrow("Supply the known encoding");
+        expect(record).not.toHaveBeenCalled();
+        await expect(read("windows-1254")).resolves.toMatchObject({ lines: [text.slice(0, 7)] });
+        expect(record).toHaveBeenCalledOnce();
+    });
+
+    it("refuses unknown encodings and binary text without recording a read", async () => {
+        const { read, record } = fixture(Uint8Array.of(0x61, 0x00, 0x62));
+
+        await expect(read("not-a-code-page")).rejects.toThrow("Unsupported text encoding");
+        await expect(read()).rejects.toThrow("Binary files");
+        expect(record).not.toHaveBeenCalled();
+    });
+});
