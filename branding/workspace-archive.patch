+
+async function isUnregisteredArchiveFolder(
+    { git, machine, paths, project, workspace }: Parameters<typeof removeWorkspaceDirectory>[0],
+    commonDir: string,
+    placement: { runnerId?: string },
+): Promise<boolean> {
+    const normalize = (value: string) => {
+        const absolute = paths.resolve(value);
+        return paths.sep === "\\" ? absolute.toLowerCase() : absolute;
+    };
+    if (
+        !paths.isAbsolute(commonDir) ||
+        normalize(await git.commonDir(project.repositoryRef, placement)) !== normalize(commonDir)
+    ) {
+        return false;
+    }
+    const maxOutputBytes = 128 * 1024;
+    const listing = await git.run(project.repositoryRef, ["worktree", "list", "--porcelain", "-z"], {
+        ...placement,
+        maxOutputBytes,
+    });
+    if (
+        listing.code !== 0 ||
+        listing.stderr.trim() !== "" ||
+        Buffer.byteLength(listing.stdout, "utf8") >= maxOutputBytes ||
+        !listing.stdout.endsWith("\0\0") ||
+        /\uFFFD|\.\.\. \d+ bytes omitted \.\.\./u.test(listing.stdout)
+    ) {
+        return false;
+    }
+    const workspacePath = normalize(workspace.path);
+    const records = listing.stdout.slice(0, -2).split("\0\0");
+    if (records.length > 128) return false;
+    for (const record of records) {
+        const [header = "", ...fields] = record.split("\0");
+        const path = header.slice("worktree ".length);
+        if (
+            !header.startsWith("worktree ") ||
+            !paths.isAbsolute(path) ||
+            fields.some((field) => field.startsWith("worktree ")) ||
+            normalize(path) === workspacePath
+        ) {
+            return false;
+        }
+        try {
+            // An alias may name the same checkout even when Git reports a different path.
+            if (normalize(await machine.fs.realpath(PRODUCT, path)) === workspacePath) return false;
+        } catch (error) {
+            if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+        }
+    }
+    return true;
+}
