+import type { WorkspacesModule } from "../../sources/workspaces/index.js";
+import { moduleDatabase } from "../support/moduleDatabase.js";
+
+const disposers: (() => void)[] = [];
+afterEach(() =>
+    disposers
+        .splice(0)
+        .reverse()
+        .forEach((dispose) => dispose()),
+);
+
+async function fixture() {
+    const coordinator = createId(),
+        child = createId(),
+        outsider = createId(),
+        project = createId();
+    const parents = new Map<string, string | null>([
+        [coordinator, null],
+        [child, coordinator],
+        [outsider, null],
+    ]);
+    const runs = new Map<string, HistoryRunState>();
+    const messages = new Set<string>();
+    const artifacts = new Set<string>();
+    const archived = new Set<string>();
+    const durable = new DurableFunctionsModule();
+    const history = {
+        run: async (_ctx: unknown, agentId: string, runId: string) => {
+            const run = runs.get(runId);
+            return run?.agentId === agentId ? run : undefined;
+        },
+        message: async (_ctx: unknown, agentId: string, messageId: string) =>
+            messages.has(agentId + ":" + messageId) ? { recordId: messageId } : undefined,
+    } as unknown as HistoryModule;
+    const surfaces = new SurfacesModule(
+        durable,
+        { enabled: false } as TeamModule,
+        {} as BotsModule,
+        {} as TasksModule,
+        {
+            get: async (_ctx: unknown, id: string) =>
+                artifacts.has(id) ? { id, status: "active" } : undefined,
+        } as unknown as ArtifactsModule,
+        {} as ComputeModule,
+        { configuration: { values: { features: { workspaces: true } } } } as ConfigModule,
+        {} as RunnersModule,
+        history,
+        {
+            get: async (_ctx: unknown, id: string) =>
+                id === project ? { id, status: "active" } : undefined,
+            projectForAgent: async (_ctx: unknown, id: string) =>
+                id === coordinator ? { id: project } : undefined,
+        } as unknown as ProjectsModule,
+        { workspaceForAgent: async () => undefined } as unknown as WorkspacesModule,
+    );
+    const db = moduleDatabase(
+        [...durable.migrations, ...surfaces.migrations],
+        "todo-execution-test",
+    );
+    ensureAgentDatabaseConnection(db.database);
+    disposers.push(() => {
+        durable.stop();
+        db.close();
+    });
+    await db.ready;
+    const agents = {
+        config: async (_ctx: unknown, id: string) =>
+            parents.has(id) ? { metadata: archived.has(id) ? { archivedAt: 200 } : {} } : undefined,
+        parentOf: async (_ctx: unknown, id: string) => parents.get(id) ?? null,
+    } as unknown as AgentSystemRef;
+    const hooks = surfaces.beforeStart(db.context, agents);
+    const list = await surfaces.create(db.context, { type: "todo", name: "Plan" }, null);
+    const actor = { agentId: coordinator, userId: null };
+    const create = (dependsOn: string[] = []) =>
+        surfaces.createTodo(
+            db.context,
+            list.id,
+            {
+                text: "Implement",
+                execution: { coordinatorAgentId: coordinator, projectId: project, dependsOn },
+            },
+            actor,
+            null,
+        );
+    const update = (todo: Todo, edit: UpdateTodoRequest, agentId: string | null = coordinator) =>
+        surfaces.mutateTodo(
+            db.context,
+            list.id,
+            todo.id,
+            todo.version,
+            "update",
+            edit,
+            { userId: null, agentId },
+            edit.mutationId,
+        );
+    return {
+        surfaces,
+        db,
+        list,
+        coordinator,
+        child,
+        outsider,
+        project,
+        actor,
+        create,
+        update,
+        runs,
+        messages,
+        artifacts,
+        archived,
+        agents,
+        hooks,
+        durable,
+        kv: new SurfacesPersistence(db.database).kv(),
+    };
+}
+
+it("preserves plain todos and records execution phases, evidence and authoritative run times", async () => {
+    const f = await fixture();
+    const plain = await f.surfaces.createTodo(
+        f.db.context,
+        f.list.id,
+        { text: "plain" },
+        f.actor,
+        null,
+    );
+    expect(plain.execution).toBeUndefined();
+    expect((await f.update(plain, { status: "completed" })).status).toBe("completed");
+    const pending = await f.create();
+    expect(
+        (await f.surfaces.list(f.db.context, f.coordinator)).map((surface) => surface.id),
+    ).toEqual([f.list.id]);
+    expect(await f.surfaces.list(f.db.context, f.outsider)).toEqual([]);
+    expect(pending.execution).toMatchObject({ phase: "pending", dependsOn: [], evidence: [] });
+    const runId = createId();
+    f.runs.set(runId, {
+        id: runId,
+        agentId: f.child,
+        status: "running",
+        reason: null,
+        startedAt: 100,
+        endedAt: null,
+    });
+    const assigned = await f.update(pending, { execution: { assigneeAgentId: f.child } });
+    const running = await f.update(
+        assigned,
+        { execution: { phase: "in_progress", runId } },
+        f.child,
+    );
+    expect(running.execution?.attempt).toMatchObject({ runId, startedAt: 100 });
+    await expect(f.update(running, { status: "completed" })).rejects.toMatchObject({
+        code: "invalid_request",
+    });
+    await expect(
+        f.update(running, { execution: { phase: "completed" } }, f.child),
+    ).rejects.toMatchObject({ code: "forbidden" });
+    await expect(f.update(running, { execution: { phase: "completed" } })).rejects.toMatchObject({
+        code: "invalid_request",
+    });
+    await expect(
+        f.update(running, { execution: { assigneeAgentId: f.coordinator } }),
+    ).rejects.toMatchObject({ code: "invalid_request" });
+    await expect(f.update(running, { execution: { runId: createId() } })).rejects.toMatchObject({
+        code: "invalid_request",
+    });
