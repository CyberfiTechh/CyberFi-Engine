+} from "../../sources/runtime/startHappyAgentRuntime.js";
+import { ScriptedProvider } from "../support/ScriptedProvider.js";
+
+// Lifecycle fixtures use public owning-module methods; HTTP and persistence are real.
+// No provider inference or transcript is needed to prove metadata-only projection.
+it("serves child execution metadata in activity and focused bootstrap, scoped and durable", async () => {
+    const home = await mkdtemp(join(tmpdir(), "sx-"));
+    const workspace = join(home, "workspace");
+    await mkdir(workspace);
+    let runtime: HappyAgentRuntime | undefined;
+    let server: Server | undefined;
+    let endpoint = "";
+    const stop = async () => {
+        server?.closeAllConnections();
+        if (server) await new Promise<void>((resolve) => server!.close(() => resolve()));
+        server = undefined;
+        await runtime?.close();
+        runtime = undefined;
+    };
+    const start = async () => {
+        const providers = new AgentProviders();
+        providers.add("gym", new ScriptedProvider([]), "codex");
+        runtime = await startHappyAgentRuntime({
+            happyHome: join(home, ".happy"),
+            environment: { ...process.env, HOME: home },
+            inference: {
+                providers,
+                models: [
+                    {
+                        id: "gym/model",
+                        providerId: "gym",
+                        name: "Gym",
+                        defaultEffort: "medium",
+                        effortLevels: ["medium"],
+                    },
+                ],
+            },
+            onPrepared: async (prepared) => {
+                server = createServer((request, response) => {
+                    void prepared.api.handleRequest(
+                        prepared.context("execution-summary.http"),
+                        request,
+                        response,
+                    );
+                });
+                await new Promise<void>((resolve, reject) => {
+                    server!.once("error", reject);
+                    server!.listen(0, "127.0.0.1", resolve);
+                });
+                const address = server.address();
+                if (!address || typeof address === "string")
+                    throw new Error("Missing HTTP fixture.");
+                endpoint = `http://127.0.0.1:${address.port}`;
+            },
+        });
+        return new HappyAgentClient({ endpoint, token: runtime.api.token()! });
+    };
+    try {
+        let client = await start();
+        const { project } = await client.registerProject({ path: workspace });
+        const { agent: parent } = await client.createAgent({
+            workspaceId: project.id,
+            title: "Coordinator",
+        });
+        const { agent: other } = await client.createAgent({
+            workspaceId: project.id,
+            title: "Other",
+        });
+        const ctx = withAgentDatabase(
+            runtime!.ctx.named("execution-summary.fixtures"),
+            runtime!.database,
+        );
+        const child = await runtime!.system.create(
+            ctx,
+            {
+                metadata: {
+                    title: "Helper",
+                    lastMode: {
+                        providerId: "gym",
+                        modelId: "gym/model",
+                        effort: "medium",
+                        serviceTier: null,
+                        permissionMode: "auto",
+                    },
+                },
+            },
+            { parent: parent.id },
+        );
+        const empty = await runtime!.system.create(
+            ctx,
+            { metadata: { title: "Not started" } },
+            { parent: parent.id },
+        );
+        expect((await client.getAgentActivity(parent.id)).subagentExecution?.[empty.id]).toEqual({
+            modelId: null,
+            latestRun: null,
+        });
+        for (const status of ["completed", "aborted", "failed"] as const) {
+            const runId = createId();
+            await runtime!.modules.history.beginMaintenanceRun(ctx, child.id, runId, 100);
+            const running = (await client.getAgentActivity(parent.id)).subagentExecution?.[
+                child.id
+            ];
+            expect(running).toEqual({
+                modelId: "gym/model",
+                latestRun: {
+                    id: runId,
+                    status: "running",
+                    reason: null,
+                    startedAt: 100,
+                    endedAt: null,
+                },
+            });
+            await runtime!.modules.history.finishMaintenanceRun(ctx, child.id, runId, status, 200);
+            const activity = await client.getAgentActivity(parent.id);
+            const summary = activity.subagentExecution?.[child.id];
+            expect(summary?.latestRun).toEqual({
+                id: runId,
+                status,
+                reason:
+                    status === "completed" ? "completed" : status === "aborted" ? "abort" : "error",
+                startedAt: 100,
+                endedAt: 200,
+            });
+            expect((await client.getAgentBootstrap(parent.id)).subagentExecution).toEqual(
+                activity.subagentExecution,
+            );
+            expect(Object.keys(activity.subagentExecution ?? {}).sort()).toEqual(
+                activity.subagents.map((agent) => agent.id).sort(),
+            );
+            expect(JSON.stringify(summary)).not.toMatch(/messages|usage|costUsd|queuedCount/);
+        }
+        expect((await client.getAgentActivity(other.id)).subagentExecution).toEqual({});
+        const unauthorized = new HappyAgentClient({ endpoint, token: "wrong-token" });
+        await expect(unauthorized.getAgentActivity(parent.id)).rejects.toMatchObject({
+            status: 401,
+        });
+        const finalSummary = (await client.getAgentActivity(parent.id)).subagentExecution;
+        await stop();
+        client = await start();
+        expect((await client.getAgentActivity(parent.id)).subagentExecution).toEqual(finalSummary);
+    } finally {
+        await stop();
+        await rm(home, { force: true, recursive: true, maxRetries: 10, retryDelay: 100 });
+    }
+}, 60_000);
