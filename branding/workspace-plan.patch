diff --git a/packages/happy-agent-client/tests/subagentExecutionProtocol.test.ts b/packages/happy-agent-client/tests/subagentExecutionProtocol.test.ts
new file mode 100644
index 0000000..4f576cb
--- /dev/null
+++ b/packages/happy-agent-client/tests/subagentExecutionProtocol.test.ts
@@ -0,0 +1,53 @@
+import { Value } from "@sinclair/typebox/value";
+import { expect, expectTypeOf, it } from "vitest";
+import {
+    subagentExecutionSchema,
+    type AgentActivityResponse,
+    type SubagentExecution,
+} from "../sources/protocol/agents.js";
+import type { AgentBootstrapResponse } from "../sources/protocol/bootstrap.js";
+
+it("keeps child execution optional on old activity and focused snapshots", () => {
+    const old: AgentActivityResponse = { subagents: [], processes: [] };
+    expect(old.subagentExecution).toBeUndefined();
+    expectTypeOf<AgentBootstrapResponse["subagentExecution"]>().toEqualTypeOf<
+        Record<string, SubagentExecution> | undefined
+    >();
+    expect(Value.Check(subagentExecutionSchema, { modelId: null, latestRun: null })).toBe(true);
+});
+
+it.each(["running", "completed", "aborted", "failed"])(
+    "accepts authoritative %s metadata",
+    (status) => {
+        const summary = {
+            modelId: "openai/gpt-6.1-sol",
+            latestRun: {
+                id: "run1",
+                status,
+                reason:
+                    status === "running"
+                        ? null
+                        : status === "completed"
+                          ? "completed"
+                          : status === "aborted"
+                            ? "abort"
+                            : "error",
+                startedAt: 100,
+                endedAt: status === "running" ? null : 200,
+            },
+        };
+        expect(Value.Check(subagentExecutionSchema, summary)).toBe(true);
+        expect(
+            Value.Check(subagentExecutionSchema, {
+                ...summary,
+                latestRun: { ...summary.latestRun, status: "idle" },
+            }),
+        ).toBe(false);
+        expect(
+            Value.Check(subagentExecutionSchema, {
+                ...summary,
+                latestRun: { ...summary.latestRun, endedAt: "200" },
+            }),
+        ).toBe(false);
+    },
+);
diff --git a/packages/happy-agent-client/tests/todoExecutionProtocol.test.ts b/packages/happy-agent-client/tests/todoExecutionProtocol.test.ts
new file mode 100644
index 0000000..a2d6e14
--- /dev/null
+++ b/packages/happy-agent-client/tests/todoExecutionProtocol.test.ts
@@ -0,0 +1,211 @@
+import { Value } from "@sinclair/typebox/value";
+import { describe, expect, it } from "vitest";
+import { HappyAgentClient } from "../sources/HappyAgentClient.js";
+
+import { todoUpdatedPayloadSchema } from "../sources/protocol/events.js";
+import {
+    createTodoRequestSchema,
+    todoExecutionSchema,
+    todoRevisionSchema,
+    todoSchema,
+    updateTodoRequestSchema,
+    surfaceListQuerySchema,
+    type TodoExecution,
+} from "../sources/protocol/surfaces.js";
+
+const execution: TodoExecution = {
+    coordinatorAgentId: "coordinator",
+    projectId: "project",
+    assigneeAgentId: "child",
+    phase: "verifying",
+    dependsOn: ["dependency"],
+    attempt: { id: "attempt", runId: "run", startedAt: 100, finishedAt: 150 },
+    evidence: [{ kind: "agent_message", agentId: "child", messageId: "message" }],
+};
+const todo = {
+    id: "todo",
+    surfaceId: "s".repeat(24),
+    authorUserId: null,
+    text: "Check the result",
+    status: "active",
+    orderKey: "5",
+    createdAt: 100,
+    updatedAt: 150,
+    completedAt: null,
+    deletedAt: null,
+    version: "version",
+};
+
+describe("optional Todo execution protocol", () => {
+    it("filters Surface discovery by a single real-format coordinator without breaking unfiltered reads", async () => {
+        const coordinatorAgentId = "c".repeat(24);
+        expect(Value.Check(surfaceListQuerySchema, {})).toBe(true);
+        expect(Value.Check(surfaceListQuerySchema, { coordinatorAgentId })).toBe(true);
+        for (const invalid of [
+            "",
+            "short",
+            "C".repeat(24),
+            `${coordinatorAgentId}\n`,
+            [coordinatorAgentId, coordinatorAgentId],
+        ]) {
+            expect(Value.Check(surfaceListQuerySchema, { coordinatorAgentId: invalid })).toBe(
+                false,
+            );
+        }
+        const requests: { url: string; signal: AbortSignal | null | undefined }[] = [];
+        const client = new HappyAgentClient({
+            endpoint: "http://agent.local",
+            token: "test",
+            fetch: async (input, init) => {
+                requests.push({ url: input.toString(), signal: init?.signal });
+                return new Response(JSON.stringify({ surfaces: [], cursor: "cursor" }), {
+                    status: 200,
+                });
+            },
+        });
+        const controller = new AbortController();
+        await client.listSurfaces();
+        await client.listSurfaces({ coordinatorAgentId, signal: controller.signal });
+        expect(requests.map((request) => request.url)).toEqual([
+            "http://agent.local/v0/surfaces",
+            `http://agent.local/v0/surfaces?coordinatorAgentId=${coordinatorAgentId}`,
+        ]);
+        expect(requests[1]?.signal).toBe(controller.signal);
+    });
+    it("preserves plain Todo reads, writes and permanent revisions", () => {
+        expect(Value.Check(todoSchema, todo)).toBe(true);
+        expect(Value.Check(createTodoRequestSchema, { text: "Plain" })).toBe(true);
+        expect(Value.Check(updateTodoRequestSchema, { status: "completed" })).toBe(true);
+        for (const snapshot of [todo, { ...todo, execution }]) {
+            expect(
+                Value.Check(todoRevisionSchema, {
+                    todo: snapshot,
+                    actor: { agentId: null, userId: null },
+                    source: "api",
+                }),
+            ).toBe(true);
+        }
+        for (const variant of todoSchema.anyOf) {
+            expect(variant.required).not.toContain("execution");
+        }
+    });
+
+    it("carries full execution in snapshots and events while allowing additive responses", () => {
+        expect(Value.Check(todoSchema, { ...todo, execution })).toBe(true);
+        expect(
+            Value.Check(todoUpdatedPayloadSchema, {
+                surfaceId: todo.surfaceId,
+                todoId: todo.id,
+                previousVersion: "previous",
+                version: todo.version,
+                changes: { execution, updatedAt: todo.updatedAt },
+            }),
+        ).toBe(true);
+        expect(
+            Value.Check(todoExecutionSchema, {
+                ...execution,
+                futureField: true,
+                evidence: [{ kind: "artifact", artifactId: "artifact", futureField: true }],
+            }),
+        ).toBe(true);
+        for (const phase of [
+            "pending",
+            "in_progress",
+            "awaiting_input",
+            "blocked",
+            "verifying",
+            "completed",
+            "failed",
+            "cancelled",
+        ]) {
+            expect(Value.Check(todoExecutionSchema, { ...execution, phase })).toBe(true);
+        }
+        expect(Value.Check(todoExecutionSchema, { ...execution, phase: "idle" })).toBe(false);
+    });
+
+    it("accepts creation and non-empty execution edits but rejects server-owned fields", () => {
+        expect(
+            Value.Check(createTodoRequestSchema, {
+                text: "Task",
+                execution: { coordinatorAgentId: "main", projectId: "project", dependsOn: [] },
+            }),
+        ).toBe(true);
+        for (const patch of [
+            { assigneeAgentId: "child" },
+            { assigneeAgentId: null },
+            { phase: "blocked" },
+            { runId: "run", phase: "in_progress" },
+            { dependsOn: [] },
+            { evidence: [{ kind: "artifact", artifactId: "artifact" }] },
+        ]) {
+            expect(Value.Check(updateTodoRequestSchema, { execution: patch })).toBe(true);
+        }
+        for (const patch of [
+            {},
+            { coordinatorAgentId: "other" },
+            { projectId: "other" },
+            { attempt: { id: "forged" } },
+            { startedAt: 1 },
+            { finishedAt: 2 },
+            { verification: { agentId: "child", userId: null, acceptedAt: 2 } },
+            { phase: "working" },
+            { evidence: [{ kind: "path", path: "secret.txt" }] },
+            { evidence: [{ kind: "artifact", artifactId: "artifact", acceptedAt: 1 }] },
+        ]) {
+            expect(Value.Check(updateTodoRequestSchema, { execution: patch })).toBe(false);
+        }
+        for (const field of ["phase", "attempt", "verification", "assigneeAgentId"]) {
+            expect(
+                Value.Check(createTodoRequestSchema, {
+                    text: "Task",
+                    execution: { coordinatorAgentId: "main", [field]: "forged" },
+                }),
+            ).toBe(false);
+        }
+    });
+
+    it("bounds distinct dependencies and evidence before runtime reference checks", () => {
+        for (const dependsOn of [
+            ["same", "same"],
+            Array.from({ length: 65 }, (_, i) => `todo${i}`),
+        ]) {
+            expect(Value.Check(updateTodoRequestSchema, { execution: { dependsOn } })).toBe(false);
+        }
+        const evidence = { kind: "artifact", artifactId: "artifact" };
+        expect(
+            Value.Check(updateTodoRequestSchema, {
+                execution: { evidence: [evidence, evidence] },
+            }),
+        ).toBe(false);
+        expect(
+            Value.Check(updateTodoRequestSchema, {
+                execution: {
+                    evidence: Array.from({ length: 65 }, (_, i) => ({
+                        ...evidence,
+                        artifactId: `${i}`,
+                    })),
+                },
+            }),
+        ).toBe(false);
+    });
+
+    it("isolates retry with an explicit receipt key and no forged attempt or mixed edits", () => {
+        expect(
+            Value.Check(updateTodoRequestSchema, {
+                execution: { retry: true },
+                mutationId: "retry-1",
+            }),
+        ).toBe(true);
+        for (const request of [
+            { execution: { retry: true } },
+            { execution: { retry: true }, mutationId: "" },
+            { execution: { retry: true }, mutationId: "x".repeat(257) },
+            { execution: { retry: false }, mutationId: "retry-1" },
+            { execution: { retry: true, phase: "pending" }, mutationId: "retry-1" },
+            { execution: { retry: true }, mutationId: "retry-1", text: "Mixed" },
+            { execution: { retry: true }, mutationId: "retry-1", status: "active" },
+        ]) {
+            expect(Value.Check(updateTodoRequestSchema, request)).toBe(false);
+        }
+    });
+});
